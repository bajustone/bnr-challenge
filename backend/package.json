{
  "name": "bnr-backend",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "docker compose -f ../docker/compose.yaml -f ../docker/compose.dev.yaml up backend",
    "dev:local": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:seed": "bun run src/db/seed.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "bnr-shared": "workspace:*",
    "@hono/standard-validator": "^0.2.0",
    "better-auth": "^1.6.10",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.18",
    "hono-openapi": "^1.3.0",
    "pino": "^9.5.0",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.7.0",
    "@types/bun": "^1.3.13",
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^11.3.0",
    "testcontainers": "^11.7.0",
    "typescript": "^6.0.3",
    "vitest": "^3.1.0"
  }
}
