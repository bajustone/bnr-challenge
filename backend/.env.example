# --- runtime --------------------------------------------------------------
NODE_ENV=development
PORT=3001

# --- database -------------------------------------------------------------
# The running backend connects as app_user (restricted; INSERT-only on audit_log).
# See docs/db-architecture.html §3.
DATABASE_URL=postgres://app_user:app_user_pw@localhost:5432/bnr

# Used ONLY by drizzle-kit and the migration/seed scripts. Never imported by
# request-handling code. Has DDL + full DML; runs grants on first migration.
DATABASE_OWNER_URL=postgres://app_owner:app_owner_pw@localhost:5432/bnr

# --- audit ----------------------------------------------------------------
# Optional pepper mixed into the audit-row hash. 16+ chars. Treat like a
# signing key: if lost, the chain becomes unverifiable.
# AUDIT_HASH_SECRET=replace-with-a-long-random-string
